# Copie este arquivo para ".env" na raiz do projeto (mesmo diretório do docker-compose.yml)
# para que o Docker Compose injete essas variáveis automaticamente no back-end.

# Chave usada para assinar os tokens JWT. OBRIGATÓRIA para subir com Docker Compose.
# Gere uma chave forte e aleatória, por exemplo com:
#   openssl rand -base64 64
# NUNCA reaproveite a mesma chave entre ambientes, e nunca a commite no repositório.
JWT_SECRET=

# Chave de API do TMDB (v3 auth), obtida gratuitamente em:
# https://www.themoviedb.org/settings/api
# A integração é opcional: sem ela, o cadastro manual de filmes/séries continua funcionando.
TMDB_API_KEY=
