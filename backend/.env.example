# Conexão com o PostgreSQL. Aceita "postgresql://..." ou "postgresql+asyncpg://..."
# (o prefixo é convertido automaticamente para o driver assíncrono).
DATABASE_URL=postgresql://biblioteca:biblioteca@localhost:5432/biblioteca

# Redis: rate limiting de login/registro e cache das buscas no TMDB.
REDIS_URL=redis://localhost:6379/0

# Obrigatório (mín. 32 caracteres). Gere com: openssl rand -base64 64
# Não existe valor padrão: a API não sobe sem JWT_SECRET.
JWT_SECRET=

# Access token: vida curta (15 min). Refresh token: vida longa (7 dias).
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Origens liberadas no CORS (separe por vírgula; "*" funciona como curinga).
# Com o proxy do Next.js (rewrites) o navegador só fala com o próprio frontend,
# então isso só importa para clientes que chamam a API diretamente.
APP_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Marca os cookies de autenticação como Secure. Use "true" em produção (HTTPS).
APP_COOKIE_SECURE=false

# Janela e limite do rate limiting em /api/auth/login e /api/auth/register (por IP).
APP_RATE_LIMIT_WINDOW_MS=60000
APP_RATE_LIMIT_MAX_ATTEMPTS=10

# Chave do TMDB (https://www.themoviedb.org/settings/api). Aceita a chave v3
# ou o "Access Token" v4 (Bearer). Em branco desabilita a integração.
TMDB_API_KEY=
