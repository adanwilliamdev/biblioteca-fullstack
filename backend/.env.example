# URL de conexão com o Postgres (usada pelo Prisma)
DATABASE_URL=postgresql://biblioteca:biblioteca@localhost:5432/biblioteca

PORT=8080

# Obrigatório em produção: gere um valor com `openssl rand -base64 64`
# NUNCA use o valor padrão do código em produção.
JWT_SECRET=d29ybGRzLW1vc3Qtc2VjcmV0LWtleS1jaGFuZ2UtaW4tcHJvZHVjdGlvbi1wbGVhc2U=

# Access token: vida curta (15 min por padrão), pois é enviado a cada requisição.
JWT_EXPIRATION_MS=900000
# Refresh token: vida longa (7 dias por padrão). Usado só para renovar o access token.
JWT_REFRESH_EXPIRATION_MS=604800000

# Domínios do frontend liberados no CORS. Separe por vírgula se tiver mais de um.
# Ex: https://meuapp.vercel.app,https://meuapp.netlify.app
APP_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Marca os cookies de autenticação como Secure (só enviados via HTTPS).
# Defina como "true" em produção (atrás de HTTPS).
APP_COOKIE_SECURE=false

# Janela e limite do rate limiting em /api/auth/login e /api/auth/register.
APP_RATE_LIMIT_WINDOW_MS=60000
APP_RATE_LIMIT_MAX_ATTEMPTS=10

# Chave da API do TMDB (https://www.themoviedb.org/settings/api). Deixe em branco para
# desabilitar a integração (o endpoint /api/tmdb/status refletirá isso).
TMDB_API_KEY=
